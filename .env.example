# ── .env.example ─────────────────────────────────────────────────────────────
# Copy to .env for local development. NEVER commit .env with real values.
# All these variables are injected into containers via Kubernetes Secrets
# and ConfigMaps in production — not via a .env file.

# ── Database ──────────────────────────────────────────────────────────────────
# Async URL for the Python backend (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://investuser:change-me@localhost:5432/investdb

# ── Backend Application ───────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
DEBUG=true

# Shared secret for n8n → backend internal endpoints
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change-me-internal-api-key

# ── AI Provider ───────────────────────────────────────────────────────────────
# Provider: mock | openai | azure | anthropic
AI_PROVIDER=mock
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Market Data Provider ──────────────────────────────────────────────────────
# Provider: mock | alpha_vantage | polygon | yahoo
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=

# ── News Provider ─────────────────────────────────────────────────────────────
# Provider: mock | newsapi | refinitiv
NEWS_PROVIDER=mock
NEWS_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── n8n ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key-32chars

# n8n database connection (plain postgres:// for n8n's built-in driver)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=investuser
DB_POSTGRESDB_PASSWORD=change-me

# ── PostgreSQL (local dev only) ───────────────────────────────────────────────
POSTGRES_USER=investuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=investdb

# ── Frontend (Vite build-time) ────────────────────────────────────────────────
# Leave empty to use Vite's dev proxy or Kubernetes Ingress routing
VITE_API_BASE_URL=
